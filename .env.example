# Server-only configuration. Never commit a populated .env file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required only when enabling the follow-up drafting agent.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Protects manual agent-run requests; use a long random value in Railway.
AGENT_RUN_TOKEN=replace-with-a-long-random-token

